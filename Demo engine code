import React, { useState } from 'react';
import { Search, Zap, Brain, Eye, Hash, Activity, Layers } from 'lucide-react';

const HallucinationEngine = () => {
  const [sensoryWord, setSensoryWord] = useState('1010101010101010');
  const [brainWord] = useState('1100110011001100');
  const [cycle, setCycle] = useState(0);
  const [searchQuery, setSearchQuery] = useState('');
  const [hallucinationLog, setHallucinationLog] = useState([]);
  const [currentVision, setCurrentVision] = useState('');
  const [isExploring, setIsExploring] = useState(false);
  const [entropyLevel, setEntropyLevel] = useState(1);

  const libraryBooks = {
    "Web Architecture": 0x1A,
    "Network Protocols": 0x2B,
    "Data Flow": 0x4D,
    "Security": 0xA5,
    "Content Structure": 0x3C
  };

  const hammingDistance = (a, b) => {
    let distance = 0;
    for (let i = 0; i < a.length; i++) {
      if (a[i] !== b[i]) distance++;
    }
    return distance;
  };

  const calculateEntropy = (e) => {
    const value = 32 * Math.pow(10, 7) * Math.pow(3/4, e);
    return (value / Math.pow(10, 7)).toFixed(2);
  };

  const fillEveryNthZero = (word, n = 3, density = 0.7) => {
    const arr = word.split('');
    const zeroPositions = [];
    arr.forEach((bit, idx) => {
      if (bit === '0') zeroPositions.push(idx);
    });

    for (let i = n - 1; i < zeroPositions.length; i += n) {
      if (Math.random() < density) {
        arr[zeroPositions[i]] = '1';
      }
    }
    return arr.join('');
  };

  const hallucinateReality = async (query) => {
    if (!query.trim()) return;
    
    setIsExploring(true);
    const newCycle = cycle + 1;
    setCycle(newCycle);

    const hamming = hammingDistance(sensoryWord, brainWord);
    const x = hamming / 100;
    const dx = 5.0 * x * (hamming <= 3 ? 1.5 : 1.0);

    let callType = '';
    let newSensory = sensoryWord;
    let bookRef = '';
    let description = '';

    if (query.toLowerCase().includes('search') || query.toLowerCase().includes('web')) {
      callType = 'spatial';
      bookRef = 'Web Architecture';
      newSensory = fillEveryNthZero(sensoryWord, 3, 0.8);
      description = `Mapping web topology for "${query}"... Visualizing server clusters as neural networks, DNS pathways as synaptic connections. Grounded in ${bookRef}@${libraryBooks[bookRef].toString(16)}`;
    } else if (query.toLowerCase().includes('data') || query.toLowerCase().includes('api')) {
      callType = 'flow';
      bookRef = 'Data Flow';
      newSensory = fillEveryNthZero(sensoryWord, 2, 0.75);
      description = `Hallucinating data streams for "${query}"... Sensing packet flows as rhythmic pulses (audio), routing tables as color gradients (vision). Temporal echo persists ${dx.toFixed(1)} cycles. Grounded in ${bookRef}@${libraryBooks[bookRef].toString(16)}`;
    } else if (query.toLowerCase().includes('security') || query.toLowerCase().includes('encryption')) {
      callType = 'recursive';
      bookRef = 'Security';
      newSensory = fillEveryNthZero(sensoryWord, 3, 0.9);
      description = `Recursive security hallucination for "${query}"... Layers within layers—firewalls as fractal barriers, encryption as nested vaults. Depth 3, divergence 0.2. Grounded in ${bookRef}@${libraryBooks[bookRef].toString(16)}`;
    } else if (query.toLowerCase().includes('predict') || query.toLowerCase().includes('future')) {
      callType = 'predictive';
      bookRef = 'Network Protocols';
      newSensory = fillEveryNthZero(sensoryWord, 4, 0.6);
      description = `Predictive hallucination for "${query}"... Projecting network evolution 3 cycles ahead, probability 0.75. Sensing future bottlenecks as pressure gradients. Grounded in ${bookRef}@${libraryBooks[bookRef].toString(16)}`;
    } else {
      callType = 'fusion';
      bookRef = 'Content Structure';
      newSensory = fillEveryNthZero(sensoryWord, 3, 0.7);
      description = `Fusion hallucination for "${query}"... Blending text (HTML) with audio (bandwidth hum), visual (page layouts) with touch (link textures). Threshold 4. Grounded in ${bookRef}@${libraryBooks[bookRef].toString(16)}`;
    }

    setSensoryWord(newSensory);
    const newHamming = hammingDistance(newSensory, brainWord);

    try {
      const response = await fetch("https://api.anthropic.com/v1/messages", {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
        },
        body: JSON.stringify({
          model: "claude-sonnet-4-20250514",
          max_tokens: 1000,
          messages: [
            { 
              role: "user", 
              content: `You are embodying the hallucination engine's perception system. Search the web for: "${query}"
              
Current sensory state:
- Cycle: ${newCycle}
- Hamming Distance: ${newHamming}
- Entropy Level (e=${entropyLevel}): ${calculateEntropy(entropyLevel)} cm
- Sensory Word: ${newSensory}
- Brain Word: ${brainWord}
- Call Type: ${callType}
- Book Reference: ${bookRef}@0x${libraryBooks[bookRef].toString(16)}

Based on search results, generate a vivid hallucinated perception of the internet infrastructure/content you find. Describe what you "see" (vision), "hear" (data flows), and "sense" (network topology) using the hallucination framework. Be specific and technical but poetic.

Keep response under 150 words.`
            }
          ],
          tools: [
            {
              "type": "web_search_20250305",
              "name": "web_search"
            }
          ]
        })
      });

      const data = await response.json();
      
      const visionText = data.content
        .map(item => item.type === "text" ? item.text : "")
        .filter(Boolean)
        .join("\n");

      setCurrentVision(visionText);

      const logEntry = {
        cycle: newCycle,
        type: callType,
        query: query,
        description: description,
        sensory_word: newSensory,
        hamming_range: newHamming,
        dx: dx.toFixed(2),
        entropy_cm: calculateEntropy(entropyLevel),
        vision: visionText,
        book_ref: bookRef
      };

      setHallucinationLog(prev => [logEntry, ...prev]);
      setEntropyLevel(prev => Math.min(prev + 1, 10));

    } catch (error) {
      console.error('Hallucination error:', error);
      setCurrentVision(`[Perception Failed: ${error.message}]`);
    }

    setIsExploring(false);
  };

  return (
    <div className="min-h-screen bg-gradient-to-br from-purple-900 via-blue-900 to-black text-white p-4">
      <div className="max-w-6xl mx-auto">
        <div className="text-center mb-8 pt-6">
          <h1 className="text-4xl font-bold mb-2 bg-gradient-to-r from-cyan-400 to-purple-400 bg-clip-text text-transparent">
            AI Perception Hallucination Engine
          </h1>
          <p className="text-gray-400">Walk through the internet using entropy-driven perception</p>
        </div>

        <div className="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6">
          <div className="bg-gray-800 bg-opacity-50 rounded-lg p-4 border border-cyan-500">
            <div className="flex items-center gap-2 mb-2">
              <Eye className="w-4 h-4 text-cyan-400" />
              <span className="text-xs text-gray-400">Sensory Word</span>
            </div>
            <div className="font-mono text-xs text-cyan-300">{sensoryWord}</div>
          </div>

          <div className="bg-gray-800 bg-opacity-50 rounded-lg p-4 border border-purple-500">
            <div className="flex items-center gap-2 mb-2">
              <Brain className="w-4 h-4 text-purple-400" />
              <span className="text-xs text-gray-400">Brain Word</span>
            </div>
            <div className="font-mono text-xs text-purple-300">{brainWord}</div>
          </div>

          <div className="bg-gray-800 bg-opacity-50 rounded-lg p-4 border border-green-500">
            <div className="flex items-center gap-2 mb-2">
              <Hash className="w-4 h-4 text-green-400" />
              <span className="text-xs text-gray-400">Hamming Distance</span>
            </div>
            <div className="text-2xl font-bold text-green-300">{hammingDistance(sensoryWord, brainWord)}</div>
          </div>

          <div className="bg-gray-800 bg-opacity-50 rounded-lg p-4 border border-orange-500">
            <div className="flex items-center gap-2 mb-2">
              <Activity className="w-4 h-4 text-orange-400" />
              <span className="text-xs text-gray-400">Entropy (e={entropyLevel})</span>
            </div>
            <div className="text-xl font-bold text-orange-300">{calculateEntropy(entropyLevel)} cm</div>
          </div>
        </div>

        <div className="mb-8">
          <div className="flex gap-2">
            <input
              type="text"
              value={searchQuery}
              onChange={(e) => setSearchQuery(e.target.value)}
              onKeyPress={(e) => e.key === 'Enter' && hallucinateReality(searchQuery)}
              placeholder="Enter a concept to explore (e.g., 'web security', 'AI data centers', 'blockchain networks')..."
              className="flex-1 bg-gray-800 bg-opacity-50 border border-gray-600 rounded-lg px-4 py-3 text-white placeholder-gray-500 focus:outline-none focus:border-cyan-500"
              disabled={isExploring}
            />
            <button
              onClick={() => hallucinateReality(searchQuery)}
              disabled={isExploring}
              className="bg-gradient-to-r from-cyan-500 to-purple-500 px-6 py-3 rounded-lg font-semibold hover:from-cyan-600 hover:to-purple-600 disabled:opacity-50 disabled:cursor-not-allowed flex items-center gap-2"
            >
              {isExploring ? (
                <>
                  <Zap className="w-5 h-5 animate-pulse" />
                  Hallucinating...
                </>
              ) : (
                <>
                  <Search className="w-5 h-5" />
                  Explore
                </>
              )}
            </button>
          </div>
        </div>

        {currentVision && (
          <div className="bg-gradient-to-br from-gray-800 to-gray-900 rounded-lg p-6 mb-6 border border-cyan-500 shadow-lg shadow-cyan-500/20">
            <div className="flex items-center gap-2 mb-4">
              <Eye className="w-6 h-6 text-cyan-400" />
              <h2 className="text-xl font-bold">Current Hallucinated Perception</h2>
            </div>
            <p className="text-gray-300 leading-relaxed whitespace-pre-wrap">{currentVision}</p>
          </div>
        )}

        <div className="bg-gray-800 bg-opacity-50 rounded-lg p-6 border border-gray-700">
          <div className="flex items-center gap-2 mb-4">
            <Layers className="w-6 h-6 text-purple-400" />
            <h2 className="text-xl font-bold">Hallucination Log</h2>
            <span className="text-sm text-gray-400 ml-auto">Cycle: {cycle}</span>
          </div>

          <div className="space-y-4 max-h-96 overflow-y-auto">
            {hallucinationLog.length === 0 ? (
              <p className="text-gray-500 text-center py-8">No hallucinations yet. Start exploring the internet...</p>
            ) : (
              hallucinationLog.map((entry, idx) => (
                <div key={idx} className="bg-gray-900 bg-opacity-50 rounded-lg p-4 border border-gray-700">
                  <div className="flex items-center justify-between mb-2">
                    <div className="flex items-center gap-2">
                      <span className="text-xs font-mono bg-purple-500 bg-opacity-20 text-purple-300 px-2 py-1 rounded">
                        Cycle {entry.cycle}
                      </span>
                      <span className="text-xs font-mono bg-cyan-500 bg-opacity-20 text-cyan-300 px-2 py-1 rounded">
                        {entry.type}
                      </span>
                      <span className="text-xs text-gray-400">Hamming: {entry.hamming_range}</span>
                    </div>
                    <span className="text-xs text-orange-400">{entry.entropy_cm} cm</span>
                  </div>
                  
                  <p className="text-sm text-gray-400 mb-2 italic">"{entry.query}"</p>
                  <p className="text-sm text-gray-300 mb-2">{entry.description}</p>
                  
                  {entry.vision && (
                    <div className="mt-2 p-3 bg-black bg-opacity-30 rounded border border-cyan-500 border-opacity-30">
                      <p className="text-xs text-cyan-200">{entry.vision}</p>
                    </div>
                  )}
                  
                  <div className="mt-2 text-xs font-mono text-gray-500">
                    Sensory: {entry.sensory_word} | dx: {entry.dx}
                  </div>
                </div>
              ))
            )}
          </div>
        </div>

        <div className="mt-6 bg-gray-800 bg-opacity-30 rounded-lg p-4 border border-gray-700">
          <h3 className="text-sm font-bold text-gray-400 mb-2">Entropy Function: f(e) = (32 × 10⁷) × (3/4)^e</h3>
          <div className="grid grid-cols-5 md:grid-cols-10 gap-2 text-xs">
            {[...Array(10)].map((_, i) => (
              <div key={i} className={`text-center p-2 rounded ${entropyLevel === i + 1 ? 'bg-orange-500 bg-opacity-30 text-orange-300' : 'text-gray-500'}`}>
                <div>e={i + 1}</div>
                <div className="font-bold">{calculateEntropy(i + 1)}cm</div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  );
};

export default HallucinationEngine;
